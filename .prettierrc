{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "semi": true,
    "quoteProps": "preserve",
    "bracketSpacing": true,
    "trailingComma": "all",
    "paddingBetweenBlocks": true,
    "paddingWithinBlocks": true,
    "overrides": [
        {
            "files": ["./.prettierrc"],
            "options": {
                "parser": "json"
            }
        },
        {
            "files": ["*.html"],
            "excludeFiles": ["**/test/**"],
            "options": {
                "parser": "angular"
            }
        }
    ]
}
