{
    "name": "angular-taskboard",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "dataconnect:generate": "firebase dataconnect:sdk:generate",
        "dataconnect:seed": "FIREBASE_DATA_CONNECT_EMULATOR_HOST=127.0.0.1:9399 firebase dataconnect:execute dataconnect/seed_data.gql SeedTasks --service angular-taskboard"
    },
    "private": true,
    "packageManager": "npm@11.20.0",
    "dependencies": {
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/forms": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/router": "^22.3.0",
        "@dataconnect/generated": "file:src/app/dataconnect-generated",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.0",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "firebase": "^13.4.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "^0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@angular/localize": "^22.3.0",
        "@eslint/js": "^10.0.1",
        "@types/jasmine": "^7.0.0",
        "@types/mocha": "^10.0.10",
        "angular-eslint": "22.8.0",
        "eslint": "^10.14.0",
        "jasmine-core": "^7.0.2",
        "jsdom": "^31.0.0",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-html-reporter": "^2.3.0",
        "less": "^4.2.0",
        "prettier": "3.10.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.0.0"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "lmdb@3.5.9": true,
        "msgpackr-extract@3.0.7": true,
        "@firebase/util@1.15.3": true,
        "protobufjs@7.6.6": true
    }
}
